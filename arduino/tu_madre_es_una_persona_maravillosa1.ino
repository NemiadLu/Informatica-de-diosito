void setup()
{
  pinMode( 2 , OUTPUT);
  pinMode( 3 , OUTPUT);
  pinMode( 4 , OUTPUT);
  pinMode( 5 , OUTPUT);
  pinMode( 6 , OUTPUT);
  pinMode( 7 , OUTPUT);
  pinMode( 8 , OUTPUT);
  pinMode( 9 , OUTPUT);
  pinMode( 10 , OUTPUT);
  pinMode( 11 , OUTPUT);
}

void loop()
{
  digitalWrite(2, true);
  delay(1200);
  digitalWrite(2, false);
  delay(1200); 
  digitalWrite(3, true);
  delay(1200); 
  digitalWrite(3, false);
  delay(1200);
  digitalWrite(4, true);
  delay(1200); 
  digitalWrite(4, false);
  delay(1200); 
  digitalWrite(5, true);
  delay(1200); 
  digitalWrite(5, false);
  delay(1200);
  digitalWrite(6, true);
  delay(1200);
  digitalWrite(6, false);
  delay(1200); 
  digitalWrite(11, true);
  delay(1200); 
  digitalWrite(11, false);
  delay(1200);
  digitalWrite(7, true);
  delay(1200); 
  digitalWrite(7, false);
  delay(1200);
  digitalWrite(8, true);
  delay(1200); 
  digitalWrite(8, false);
  delay(1200); 
  digitalWrite(9, true);
  delay(1200); 
  digitalWrite(9, false);
  delay(1200);
  digitalWrite(10, true);
  delay(1200); 
  digitalWrite(10, false);
  delay(1200);
}